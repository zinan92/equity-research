{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://park-research.local/schemas/research-report-payload-v1.schema.json",
  "title": "Park renderable research report payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ticker",
    "name",
    "exchange",
    "title",
    "industry",
    "as_of",
    "known_at",
    "data_mode",
    "research_status",
    "research_depth",
    "report_version",
    "generated_from",
    "market",
    "executive",
    "thesis",
    "business_model",
    "industry_position",
    "management",
    "financials",
    "serenity",
    "valuation",
    "catalysts",
    "risks",
    "falsification",
    "watchlist",
    "sources",
    "evidence_summary",
    "source_contract",
    "disclaimer",
    "report_contract"
  ],
  "properties": {
    "ticker": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "exchange": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "industry": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "minLength": 1
    },
    "known_at": {
      "type": "string",
      "minLength": 1
    },
    "data_mode": {
      "type": "string",
      "minLength": 1
    },
    "research_status": {
      "enum": [
        "verified",
        "baseline"
      ]
    },
    "research_depth": {
      "enum": [
        "deep",
        "quantitative_baseline"
      ]
    },
    "report_version": {
      "type": "string",
      "minLength": 1
    },
    "generated_from": {
      "type": "object",
      "required": [
        "snapshot_id"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "publication_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_set_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_manifest_hash": {
          "type": "string",
          "minLength": 1
        },
        "evidence_gate_hash": {
          "type": "string",
          "minLength": 1
        },
        "production_input_identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "snapshot_manifest_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "baseline_payload_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "template_version": {
          "type": "string",
          "minLength": 1
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "narrative_model": {
          "type": "string",
          "minLength": 1
        },
        "prompt_version": {
          "type": "string",
          "minLength": 1
        },
        "model_boundary_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "market": {
      "type": "object",
      "required": [
        "price",
        "change_pct",
        "pe_ttm",
        "pb",
        "market_cap_yi",
        "return_20d",
        "return_60d",
        "return_250d",
        "volatility_60d",
        "max_drawdown_250d",
        "ma20",
        "ma60",
        "ma200",
        "composite_score"
      ],
      "properties": {
        "price": {
          "$ref": "#/$defs/nullableNumber"
        },
        "change_pct": {
          "$ref": "#/$defs/nullableNumber"
        },
        "pe_ttm": {
          "$ref": "#/$defs/nullableNumber"
        },
        "pb": {
          "$ref": "#/$defs/nullableNumber"
        },
        "market_cap_yi": {
          "$ref": "#/$defs/nullableNumber"
        },
        "return_20d": {
          "$ref": "#/$defs/nullableNumber"
        },
        "return_60d": {
          "$ref": "#/$defs/nullableNumber"
        },
        "return_250d": {
          "$ref": "#/$defs/nullableNumber"
        },
        "volatility_60d": {
          "$ref": "#/$defs/nullableNumber"
        },
        "max_drawdown_250d": {
          "$ref": "#/$defs/nullableNumber"
        },
        "ma20": {
          "$ref": "#/$defs/nullableNumber"
        },
        "ma60": {
          "$ref": "#/$defs/nullableNumber"
        },
        "ma200": {
          "$ref": "#/$defs/nullableNumber"
        },
        "composite_score": {
          "$ref": "#/$defs/nullableNumber"
        }
      },
      "additionalProperties": false
    },
    "executive": {
      "type": "object",
      "required": [
        "stance",
        "summary",
        "action",
        "score",
        "current_price",
        "key_contradiction",
        "execution_range",
        "position_plan"
      ],
      "properties": {
        "stance": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "score": {
          "type": "number"
        },
        "current_price": {
          "type": "number"
        },
        "key_contradiction": {
          "type": "string",
          "minLength": 1
        },
        "execution_range": {
          "type": "string",
          "minLength": 1
        },
        "position_plan": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/positionStep"
          }
        },
        "target_weight": {
          "$ref": "#/$defs/nullableNumber"
        },
        "model_observation_weight": {
          "$ref": "#/$defs/nullableNumber"
        },
        "proposed_initial_weight": {
          "$ref": "#/$defs/nullableNumber"
        },
        "decision_review_weight": {
          "$ref": "#/$defs/nullableNumber"
        },
        "current_executable_weight": {
          "$ref": "#/$defs/nullableNumber"
        },
        "max_target_weight": {
          "$ref": "#/$defs/nullableNumber"
        },
        "weight_semantics": {
          "type": "string",
          "minLength": 1
        },
        "publication_approval_current": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "thesis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/thesisClaim"
      }
    },
    "business_model": {
      "type": "object",
      "required": [
        "description",
        "source_ids",
        "segments",
        "value_chain"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "$ref": "#/$defs/sourceIds"
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/businessSegment"
          }
        },
        "value_chain": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/valueChain"
          }
        }
      },
      "additionalProperties": false
    },
    "industry_position": {
      "type": "object",
      "required": [
        "headline",
        "source_ids",
        "metrics"
      ],
      "properties": {
        "headline": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "$ref": "#/$defs/sourceIds"
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/industryMetric"
          }
        }
      },
      "additionalProperties": false
    },
    "management": {
      "type": "object",
      "required": [
        "score",
        "strengths",
        "watchouts",
        "source_ids"
      ],
      "properties": {
        "score": {
          "type": [
            "number",
            "null"
          ]
        },
        "strengths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "watchouts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_ids": {
          "$ref": "#/$defs/sourceIds"
        }
      },
      "additionalProperties": false
    },
    "financials": {
      "type": "object",
      "required": [
        "headline",
        "annual_quality",
        "series",
        "quality_notes"
      ],
      "properties": {
        "headline": {
          "type": "string",
          "minLength": 1
        },
        "latest_period": {
          "type": [
            "string",
            "null"
          ]
        },
        "latest_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "annual_quality": {
          "$ref": "#/$defs/annualQuality"
        },
        "series": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/financialPeriod"
          }
        },
        "quality_notes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "serenity": {
      "type": "object",
      "required": [
        "raw_score",
        "penalty",
        "final_score",
        "label",
        "meaning",
        "method",
        "factors",
        "penalties"
      ],
      "properties": {
        "raw_score": {
          "type": "number"
        },
        "penalty": {
          "type": "number"
        },
        "final_score": {
          "type": "number"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "factors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/frameworkFactor"
          }
        },
        "penalties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frameworkPenalty"
          }
        }
      },
      "additionalProperties": false
    },
    "valuation": {
      "type": "object",
      "required": [
        "currency",
        "current_price",
        "method",
        "pe_ttm",
        "pb"
      ],
      "properties": {
        "currency": {
          "enum": [
            "CNY",
            "HKD",
            "USD"
          ]
        },
        "current_price": {
          "type": "number"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "pe_ttm": {
          "type": [
            "number",
            "null"
          ]
        },
        "pb": {
          "type": [
            "number",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/valuationScenario"
          }
        },
        "earnings_bridge": {
          "$ref": "#/$defs/earningsBridge"
        },
        "base_view": {
          "type": "string",
          "minLength": 1
        },
        "reverse_implied": {
          "type": "string",
          "minLength": 1
        },
        "warning": {
          "type": "string",
          "minLength": 1
        },
        "earnings_label": {
          "type": "string",
          "minLength": 1
        },
        "multiple_label": {
          "type": "string",
          "minLength": 1
        },
        "formula_label": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "status",
            "reason"
          ]
        },
        {
          "required": [
            "scenarios",
            "earnings_bridge",
            "base_view",
            "reverse_implied",
            "warning"
          ]
        }
      ],
      "additionalProperties": false
    },
    "catalysts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/catalyst"
      }
    },
    "risks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/risk"
      }
    },
    "falsification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "watchlist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/watchItem"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "evidence_summary": {
      "type": "object",
      "required": [
        "boundary",
        "document_count",
        "independent_document_count",
        "claim_locator_count"
      ],
      "properties": {
        "boundary": {
          "type": "string",
          "minLength": 1
        },
        "document_count": {
          "type": "integer",
          "minimum": 1
        },
        "independent_document_count": {
          "type": "integer",
          "minimum": 0
        },
        "claim_locator_count": {
          "type": "integer",
          "minimum": 0
        },
        "primary_count": {
          "type": "integer",
          "minimum": 0
        },
        "company_release_count": {
          "type": "integer",
          "minimum": 0
        },
        "frozen_document_count": {
          "type": "integer",
          "minimum": 0
        },
        "frozen_evidence_set_id": {
          "type": "string",
          "minLength": 1
        },
        "frozen_manifest_hash": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "source_contract": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/sourceIds"
      }
    },
    "disclaimer": {
      "type": "string",
      "minLength": 1
    },
    "report_contract": {
      "type": "object",
      "required": [
        "schema_version",
        "contract_version",
        "module_manifest"
      ],
      "properties": {
        "schema_version": {
          "const": "research-report-v1"
        },
        "contract_version": {
          "const": "1.0.0"
        },
        "module_manifest": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8
        }
      }
    },
    "market_known_at": {
      "type": "string",
      "minLength": 1
    },
    "research_known_at": {
      "type": "string",
      "minLength": 1
    },
    "research_logic_hash": {
      "type": "string",
      "minLength": 1
    },
    "research_profile_hash": {
      "type": "string",
      "minLength": 1
    },
    "report_hash": {
      "type": "string",
      "minLength": 1
    },
    "data_status": {
      "type": "string",
      "minLength": 1
    },
    "depth_disclosure": {
      "type": "string",
      "minLength": 1
    },
    "portfolio_context": {
      "$ref": "#/$defs/portfolioContext"
    },
    "publication_approval": {
      "$ref": "#/$defs/publicationApproval"
    },
    "decision_blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "update_diff": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/updateDiff"
        }
      ]
    },
    "moat": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/signalItem"
      }
    },
    "quant_signals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/signalItem"
      }
    },
    "stress_test": {
      "$ref": "#/$defs/stressTest"
    },
    "ai_narrative": {
      "$ref": "#/$defs/aiNarrative"
    },
    "narrative_provider": {
      "$ref": "#/$defs/narrativeProvider"
    }
  },
  "dependentRequired": {
    "ai_narrative": [
      "narrative_provider"
    ],
    "narrative_provider": [
      "ai_narrative"
    ]
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "research_depth": {
            "const": "deep"
          }
        },
        "required": [
          "research_depth"
        ]
      },
      "then": {
        "required": [
          "moat"
        ],
        "properties": {
          "moat": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/signalItem"
            }
          },
          "valuation": {
            "required": [
              "scenarios",
              "earnings_bridge",
              "base_view",
              "reverse_implied",
              "warning"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "report_version": {
            "const": "cross-company-research-v1"
          }
        },
        "required": [
          "report_version"
        ]
      },
      "then": {
        "properties": {
          "generated_from": {
            "required": [
              "snapshot_id",
              "evidence_set_id",
              "evidence_manifest_hash",
              "production_input_identity",
              "snapshot_manifest_hash",
              "baseline_payload_hash",
              "template_version",
              "adapter_version",
              "narrative_model",
              "prompt_version",
              "model_boundary_version"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "research_depth": {
            "const": "quantitative_baseline"
          }
        },
        "required": [
          "research_depth"
        ]
      },
      "then": {
        "required": [
          "quant_signals",
          "stress_test"
        ],
        "properties": {
          "quant_signals": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/signalItem"
            }
          },
          "valuation": {
            "required": [
              "status",
              "reason"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "nullableNumber": {
      "type": [
        "number",
        "null"
      ]
    },
    "scalar": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "positionStep": {
      "type": "object",
      "required": [
        "stage",
        "weight",
        "condition"
      ],
      "properties": {
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "number"
        },
        "condition": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "thesisClaim": {
      "type": "object",
      "required": [
        "title",
        "body",
        "claim_type",
        "source_ids"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "claim_type": {
          "enum": [
            "fact",
            "inference",
            "assumption"
          ]
        },
        "source_ids": {
          "$ref": "#/$defs/sourceIds"
        },
        "method": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "claim_type": {
                "const": "assumption"
              }
            }
          },
          "then": {
            "required": [
              "method"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "businessSegment": {
      "type": "object",
      "required": [
        "name",
        "revenue_yi",
        "revenue_share",
        "growth",
        "gross_margin"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "revenue_yi": {
          "$ref": "#/$defs/nullableNumber"
        },
        "revenue_share": {
          "$ref": "#/$defs/nullableNumber"
        },
        "growth": {
          "$ref": "#/$defs/nullableNumber"
        },
        "gross_margin": {
          "$ref": "#/$defs/nullableNumber"
        }
      },
      "additionalProperties": false
    },
    "valueChain": {
      "type": "object",
      "required": [
        "layer",
        "items",
        "question"
      ],
      "properties": {
        "layer": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "industryMetric": {
      "type": "object",
      "required": [
        "label",
        "value",
        "note"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "$ref": "#/$defs/scalar"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "annualQuality": {
      "type": "object",
      "required": [
        "roe",
        "gross_margin",
        "net_margin",
        "debt_ratio"
      ],
      "properties": {
        "roe": {
          "$ref": "#/$defs/nullableNumber"
        },
        "gross_margin": {
          "$ref": "#/$defs/nullableNumber"
        },
        "net_margin": {
          "$ref": "#/$defs/nullableNumber"
        },
        "debt_ratio": {
          "$ref": "#/$defs/nullableNumber"
        },
        "operating_cash_per_share": {
          "$ref": "#/$defs/nullableNumber"
        }
      },
      "additionalProperties": false
    },
    "financialPeriod": {
      "type": "object",
      "required": [
        "report_date",
        "report_type",
        "revenue_yi",
        "net_profit_yi",
        "revenue_yoy",
        "net_profit_yoy",
        "gross_margin"
      ],
