      "type": "object",
      "required": [
        "id",
        "document_id",
        "title",
        "kind",
        "strength",
        "known_at",
        "url",
        "note"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "primary",
            "company_release",
            "independent",
            "market_snapshot"
          ]
        },
        "strength": {
          "enum": [
            "强",
            "中",
            "弱",
            "strong",
            "medium",
            "lead"
          ]
        },
        "known_at": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^https://[^\\s]+$"
            }
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "quote_time": {
          "type": "string",
          "minLength": 1
        },
        "evidence_manifest_hash": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "market_snapshot"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "snapshot_id",
              "provider",
              "quote_time"
            ]
          }
        }
      ],
      "additionalProperties": false
    }
  }
