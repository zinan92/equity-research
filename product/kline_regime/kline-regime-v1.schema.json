{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://park.local/schemas/kline-regime-v1.schema.json",
  "title": "K-line regime v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["regime", "range_low", "range_high", "confidence", "as_of", "inputs_digest", "action_eligible", "version", "asset"],
  "properties": {
    "regime": {"enum": ["trend_up", "trend_down", "range", "unavailable"]},
    "range_low": {"type": ["number", "null"]},
    "range_high": {"type": ["number", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "as_of": {"type": ["string", "null"]},
    "inputs_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "action_eligible": {"const": false},
    "version": {"const": "kline-regime-v1"},
    "reason": {"type": "string", "minLength": 1},
    "asset": {"type": "string", "minLength": 1}
  },
  "if": {"properties": {"regime": {"const": "unavailable"}}},
  "then": {"required": ["reason"]},
  "else": {"not": {"required": ["reason"]}}
}
